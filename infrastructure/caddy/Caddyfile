# Reverse proxy + automatic HTTPS (Let's Encrypt) for everything served from this VPS: the proke backend and
# the Gardener game server (github.com/ablaszkiewicz/gardener-game).
#
# Deployed to the VPS by .github/workflows/caddy-deploy.yml. Caddy runs with --network host, so it binds host :80
# and :443 - :80 is what Let's Encrypt hits for the ACME challenge, :443 is where TLS is terminated - and reaches
# each backend on a localhost port its container publishes on loopback only.
#
# Every host here must be DNS-only in Cloudflare (grey cloud). Proxied, the challenge lands on Cloudflare's edge
# instead of this box and the certificate never issues.

{
	# ACME contact address for cert-expiry notices. Caddy works without it.
	email kqmdjc8@gmail.com
}

backend.proke.dev {
	reverse_proxy localhost:48211
}

# Gardener: HTTP API and the /ws WebSocket gateway, from one container (gardener-game's
# .github/workflows/deploy.yml runs it on 127.0.0.1:47350). reverse_proxy passes WebSocket upgrades through as
# they are. A redeploy of Caddy drops every live match, so push changes here when nobody is playing.
# backend.garden-wars.io is the new name; the old one stays until the client's VITE_SERVER_URL points at the new.
backend.garden-wars.io, backend.garden-wars.ablaszkiewicz.pl {
	reverse_proxy localhost:47350
}
