# Copy to .env.tunnel to get a permanent tunnel hostname instead of a throwaway one.
#
# Without this, scripts/tunnels.mjs opens a quick tunnel: a new *.trycloudflare.com on every
# restart, which means re-pasting the webhook and redirect URLs into GitHub and Slack every
# session. With it, they are pasted once and never again.
#
# One-time, using a domain in your Cloudflare account:
#
#   cloudflared login
#   cloudflared tunnel create proke
#   cloudflared tunnel route dns proke proke-api.yourdomain.com

TUNNEL_NAME=proke
TUNNEL_API_HOSTNAME=proke-api.yourdomain.com

# Optional. Nothing needs the frontend to be public - the backend hands OAuth callbacks back to
# it on localhost - but set this and it gets an ingress rule too, for showing somebody the UI.
#   cloudflared tunnel route dns proke proke-app.yourdomain.com
# TUNNEL_APP_HOSTNAME=proke-app.yourdomain.com
