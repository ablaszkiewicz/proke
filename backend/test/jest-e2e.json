{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".spec.ts$",
  "globalSetup": "<rootDir>/utils/global-mongo.ts",
  "globalTeardown": "<rootDir>/utils/global-mongo-teardown.ts",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/../tsconfig.json" }]
  }
}
