# Where this app is served from - must match the GitHub OAuth app's callback host.
VITE_APP_URL=http://localhost:49173

# The NestJS backend.
VITE_API_URL=http://localhost:48211

# Client ID of the GitHub App (Settings -> Developer settings -> GitHub Apps).
# Its "Callback URL" must be
# http://localhost:49173/app/callbacks/oauth/github
# The matching client secret goes in backend/.env, never here.
VITE_GH_APP_CLIENT_ID=
