# Where this app is served from - must match the GitHub OAuth app's callback host.
VITE_APP_URL=http://localhost:49173

# The NestJS backend.
VITE_API_URL=http://localhost:48211

# Client ID of the GitHub App (Settings -> Developer settings -> GitHub Apps).
# Its "Callback URL" must be
# http://localhost:49173/app/callbacks/oauth/github
# The matching client secret goes in backend/.env, never here.
VITE_GH_APP_CLIENT_ID=

# --- PostHog ---
# Leave blank and the browser sends nothing at all, which is the right default for a local run:
# development clicks should not be in the numbers.
#
# The project token from Project settings. Public by design - it is compiled into the bundle and
# can only write events - unlike a personal API key, which must never appear in this file.
VITE_POSTHOG_KEY=

# EU project. Use https://us.i.posthog.com for a US one; the token only works against its own.
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Note: Vite inlines VITE_* at build time, and `pnpm deploy` builds locally before pushing to
# Cloudflare. So this file - not a CI secret - is what decides whether the deployed bundle has
# analytics in it. There is no frontend workflow to set it in.
